{
  "schema_version": "1.0",
  "name": "budget-guardrail",
  "description": "Bring a discipline budget inside the approved cap while preserving ordering and non-negativity.",
  "metadata": {"domain": "project-controls"},
  "variables": {
    "civil": {"lower": 0, "label": "Civil", "unit": "CAD"},
    "mechanical": {"lower": 0, "label": "Mechanical", "unit": "CAD"},
    "electrical": {"lower": 0, "label": "Electrical", "unit": "CAD"}
  },
  "equations": [
    {"id": "approved-cap", "expression": "civil + mechanical + electrical <= 1000000"},
    {"id": "electrical-not-above-mechanical", "expression": "electrical <= mechanical"}
  ]
}
