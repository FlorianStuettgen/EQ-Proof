{
  "schema_version": "1.0",
  "name": "portfolio-allocation",
  "description": "Repair an allocation to 100% while preserving the approved reserve.",
  "metadata": {"domain": "forecasting", "owner": "portfolio-controls"},
  "variables": {
    "forecast_a": {"lower": 0, "upper": 1, "label": "Forecast A", "unit": "share"},
    "forecast_b": {"lower": 0, "upper": 1, "label": "Forecast B", "unit": "share"},
    "forecast_c": {"lower": 0, "upper": 1, "fixed": true, "label": "Approved reserve", "unit": "share"}
  },
  "equations": [
    {
      "id": "allocation-total",
      "description": "The complete allocation must equal 100%.",
      "expression": "forecast_a + forecast_b + forecast_c == 1"
    }
  ]
}
